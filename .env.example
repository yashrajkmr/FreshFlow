# FreshFlow Enterprise Environment Configuration
# Copy this file to .env for local overrides or set these in your cloud dashboard (Render/Railway/Vercel)

# Port to bind server (Render/Railway injects PORT automatically)
PORT=3001

# MongoDB Atlas Connection String
# Replace with your MongoDB Atlas cluster URI for cloud deployment
# For local development: mongodb://127.0.0.1:27017/freshflow
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/freshflow?retryWrites=true&w=majority

# JWT Token Secret for Store Manager & Staff RBAC authentication
JWT_SECRET=freshflow_production_jwt_secret_key_2026

# Node Environment
NODE_ENV=production
